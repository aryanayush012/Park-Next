; Pin the real public npm registry for this project specifically, no matter
; what a machine's global/work npm config points at. Added after a local
; `npm ci` timed out reaching `npmregistry-dev.cwsystem.in` — an internal
; registry mirror (unreachable off whatever network/VPN it needs, or just
; down) that this machine is configured to use for npm installs generally,
; almost certainly for work projects. ParkNext has no dependency on
; anything internal, so it has no reason to go through that mirror at all —
; a project-level `.npmrc` entry like this one takes precedence over
; user/global npm config for anyone running npm from inside this folder,
; without changing that global config for any other project.
registry=https://registry.npmjs.org/

; Makes npm retry harder on a slow/flaky registry connection instead of
; giving up. Added after two EAS Build failures both showing npm's own
; internal "Exit handler never called!" bug (a known, long-standing npm
; issue — see https://github.com/npm/cli/issues/8974,
; https://github.com/npm/cli/issues/9245 — unrelated to anything in this
; project's own dependencies) during `npm ci --include=dev`, each after
; several minutes of otherwise-normal install output. That timing pattern
; points at the registry connection stalling partway through rather than a
; guaranteed reproducible bug, so these settings give npm more room to
; retry a stalled fetch before it gives up in the exact way that trips the
; "Exit handler" bug. `eas.json`'s explicit `npm` version pin (see the
; comment there) is the other half of this fix.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000