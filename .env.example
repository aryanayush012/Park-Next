# Copy this file to `.env` (same folder) and fill in your own values from
# Supabase → Project Settings → API. Restart `npx expo start` afterwards —
# Expo only reads .env at dev-server startup, and EXPO_PUBLIC_* values are
# inlined into the JS bundle at that point.
#
# Leave these blank/absent and the app deliberately falls back to in-memory
# mock data, where sign-in (including "Continue with Google") is simulated
# and always "succeeds". See supabase/README.md.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
