{
  "expo": {
    "name": "ParkNext",
    "slug": "parknext-app",
    "scheme": "parknext",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D12",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0B0D12"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ParkNext uses your photo library so you can add photos to your parking listing or profile.",
          "cameraPermission": "ParkNext uses your camera so you can take photos for your parking listing or profile."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ParkNext uses your location to find nearby parking spots and center the map on where you are."
        }
      ],
      ["expo-notifications"]
    ]
  }
}